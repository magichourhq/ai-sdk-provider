{
  "name": "@magichourhq/ai-sdk-provider",
  "version": "0.3.0",
  "packageManager": "yarn@4.18.0",
  "description": "Magic Hour image and video provider for the AI SDK",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magichourhq/ai-sdk-provider.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "tsc --noEmit -p tsconfig.test.json",
    "example": "tsx example.ts",
    "prepack": "yarn build"
  },
  "dependencies": {
    "@ai-sdk/provider": "^4.0.31",
    "@magichourhq/browser-client": "^0.3.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.1.0",
    "ai": "^7.0.148",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "ai": "^7.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
